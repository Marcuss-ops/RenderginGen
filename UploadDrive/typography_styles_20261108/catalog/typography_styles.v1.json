{
  "schema": "chronontemplate.typography-styles.v1",
  "title": "Elegant phrase typography — runtime Font / Shadow / Glow",
  "description": "Pre-saved phrase looks for 1920x1080 video. A preset is a complete combination; font, shadow and glow can each be replaced at runtime without editing the plan.",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "duration_frames": 240
  },
  "default_phrase": "Le menti che hanno cambiato il mondo",
  "defaults": {
    "box": [1840, 480],
    "text_align": "center"
  },
  "fonts": {
    "playfair_display": {
      "family": "Playfair Display",
      "path": "assets/fonts/PlayfairDisplay.ttf",
      "category": "didone_serif"
    },
    "playfair_display_bold": {
      "family": "Playfair Display Bold",
      "path": "assets/fonts/PlayfairDisplay-Bold.ttf",
      "category": "didone_serif"
    },
    "playfair_display_italic": {
      "family": "Playfair Display Italic",
      "path": "assets/fonts/PlayfairDisplay-Italic.ttf",
      "category": "didone_serif"
    },
    "bodoni_moda": {
      "family": "Bodoni Moda",
      "path": "assets/fonts/BodoniModa-Regular.ttf",
      "category": "didone_serif"
    },
    "bodoni_moda_bold_italic": {
      "family": "Bodoni Moda Bold Italic",
      "path": "assets/fonts/BodoniModa-BoldItalic.ttf",
      "category": "didone_serif"
    },
    "didot_italic": {
