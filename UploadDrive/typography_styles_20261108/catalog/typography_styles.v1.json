    },
    "urbanist": {
      "family": "Urbanist",
      "path": "assets/fonts/Urbanist.ttf",
      "category": "modern_sans"
    }
  },
  "shadows": {
    "none": {
      "label": "Nessuna ombra",
      "color": "#000000",
      "opacity": 0.0,
      "blur": 0.0,
      "offset": [0.0, 0.0]
    },
    "ink_whisper": {
      "label": "Ombra inchiostro lieve",
      "color": "#000000",
      "opacity": 0.10,
      "blur": 12.0,
      "offset": [0.0, 2.0]
    },
    "ink_soft": {
      "label": "Ombra inchiostro morbida",
      "color": "#000000",
      "opacity": 0.16,
      "blur": 18.0,
      "offset": [0.0, 3.0]
    },
    "ink_editorial": {
      "label": "Ombra editoriale netta",
      "color": "#000000",
      "opacity": 0.22,
      "blur": 9.0,
      "offset": [2.0, 3.0]
    },
    "warm_paper": {
      "label": "Ombra carta calda",
      "color": "#2A2118",
      "opacity": 0.13,
      "blur": 14.0,
      "offset": [0.0, 2.0]
    },
    "noir_soft": {
      "label": "Ombra noir profonda",
      "color": "#000000",
      "opacity": 0.34,
      "blur": 26.0,
      "offset": [0.0, 6.0]
    }
  },
  "glows": {
    "none": {
      "label": "Nessun glow",
      "color": "#000000",
      "radius": 0.0,
      "intensity": 0.0
    },
    "ink_halo": {
      "label": "Alone inchiostro",
      "color": "#000000",
      "radius": 18.0,
      "intensity": 0.08
    },
    "ink_halo_soft": {
      "label": "Alone inchiostro morbido",
      "color": "#000000",
      "radius": 26.0,
      "intensity": 0.05
    },
    "champagne_glow": {
      "label": "Glow champagne",
      "color": "#D8B36A",
      "radius": 22.0,
      "intensity": 0.08
    },
    "gold_glow": {
      "label": "Glow oro",
      "color": "#C9A45C",
      "radius": 24.0,
      "intensity": 0.10
    },
    "warm_white": {
      "label": "Glow bianco caldo",
      "color": "#FFF4DE",
      "radius": 20.0,
      "intensity": 0.08
    },
    "white_halo": {
      "label": "Alone bianco",
      "color": "#FFFFFF",
      "radius": 20.0,
      "intensity": 0.07
    },
    "cyan_glow": {
      "label": "Glow ciano",
      "color": "#49D6E8",
      "radius": 22.0,
      "intensity": 0.10
    },
    "blue_glow": {
      "label": "Glow blu",
      "color": "#5A8DEE",
      "radius": 22.0,
      "intensity": 0.09
    },
    "amber_glow": {
      "label": "Glow ambra",
      "color": "#E0A85A",
      "radius": 20.0,
      "intensity": 0.09
    }
  },
  "families": [
    {
      "id": "editoriale_didone",
      "label": "Editoriale Didone",
      "description": "Playfair, Bodoni e Didot: il registro classico da documentario."
    },
    {
      "id": "serif_moderno",
      "label": "Serif moderno",
      "description": "Serif contemporanei, dal taglio editoriale al manifesto."
    },
    {
      "id": "sans_broadcast",
      "label": "Sans broadcast",
      "description": "Sans leggibili e autorevoli per titoli e lower third."
    },
    {
      "id": "sans_moderno",
      "label": "Sans moderno",
      "description": "Grotesk e condensati per un taglio più contemporaneo."
    }
  ],
  "presets": [
    {
      "id": "01_playfair_base_attuale",
      "label": "Playfair · bianco e nero (base attuale)",
      "family": "editoriale_didone",
      "font": "playfair_display",
      "font_size": 94,
      "fill": "#000000",
      "background": "#FFFFFF",
      "shadow": "none",
      "glow": "ink_halo",
      "note": "La combinazione usata oggi: Playfair nero su bianco con alone nero."
    },
    {
      "id": "02_playfair_carta",
      "label": "Playfair · inchiostro su carta",
      "family": "editoriale_didone",
      "font": "playfair_display",
      "font_size": 94,
      "fill": "#0B0B0B",
      "background": "#F5F1E8",
      "shadow": "ink_soft",
      "glow": "ink_halo_soft",
      "note": "La base attuale raffinata: carta calda, ombra corta, alone quasi invisibile."
    },
    {
