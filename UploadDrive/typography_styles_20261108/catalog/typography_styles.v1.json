      "path": "assets/fonts/DM-Serif-Display.ttf",
      "category": "editorial_serif"
    },
    "dm_serif_display_italic": {
      "family": "DM Serif Display Italic",
      "path": "assets/fonts/DM-Serif-Display-Italic.ttf",
      "category": "editorial_serif"
    },
    "libre_bodoni_italic": {
      "family": "Libre Bodoni Italic",
      "path": "assets/fonts/LibreBodoni-Italic.ttf",
      "category": "editorial_serif"
    },
    "abril_fatface": {
      "family": "Abril Fatface",
      "path": "assets/fonts/AbrilFatface-Regular.ttf",
      "category": "poster_serif"
    },
    "montserrat_extra_bold": {
      "family": "Montserrat ExtraBold",
      "path": "assets/fonts/Montserrat-ExtraBold.ttf",
      "category": "broadcast_sans"
    },
    "inter_medium": {
      "family": "Inter Medium",
      "path": "assets/fonts/Inter-Medium.ttf",
      "category": "broadcast_sans"
    },
    "inter_light": {
      "family": "Inter Light",
      "path": "assets/fonts/Inter-Light.ttf",
      "category": "broadcast_sans"
    },
    "manrope": {
      "family": "Manrope",
      "path": "assets/fonts/Manrope.ttf",
      "category": "broadcast_sans"
    },
    "sf_pro_light": {
      "family": "SF Pro Display Light",
      "path": "assets/fonts/SF-Pro-Display-Light.otf",
      "category": "broadcast_sans"
    },
    "space_grotesk": {
      "family": "Space Grotesk",
      "path": "assets/fonts/Space-Grotesk.ttf",
      "category": "modern_sans"
    },
    "sora": {
      "family": "Sora",
      "path": "assets/fonts/Sora.ttf",
      "category": "modern_sans"
    },
    "oswald_medium": {
      "family": "Oswald Medium",
      "path": "assets/fonts/Oswald-Medium.ttf",
      "category": "condensed_sans"
    },
    "bricolage_grotesque": {
      "family": "Bricolage Grotesque",
      "path": "assets/fonts/Bricolage-Grotesque.ttf",
