# Go
*.exe
*.test
*.out
renderinggen/renderinggen
renderinggen/bin/
/bin/
.tmp/
renderinggen/.tmp/
queue/queued
queue/bin/
objectstore/objectstore
objectstore/bin/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Env / secrets
.env
*.local.yaml

# Google service-account keys (never commit)
*gcp-service-account*.json
*service-account*.json
*.credentials.json

# Google Drive OAuth client + token (never commit)
credentials.json
token.json

# Generated render/benchmark artifacts
# Per-frame telemetry sidecars are pure diagnostics: a render regenerates them
# on demand, each one is ~1.2 MB of per-frame JSON, and they are the bulk of
# the artifact bloat here. They are never committed in any directory, not just
# the roots enumerated below.
*.mp4.timing.json
*.mp4.telemetry-summary.json
/renderinggen/*.mp4
/renderinggen/*.mp4.timing.json
/renderinggen/*.mp4.receipt.json
/renderinggen/*_plan.json
/renderinggen/concurrent_test_videos/
/renderinggen/modern_preset_videos/
/renderinggen/phrase_preset_videos/
/renderinggen/preset_videos/
/renderinggen/highend_phrase_videos/
/renderinggen/typography_benchmark_videos/
/renderinggen/warm_videos/
/typography_benchmark_videos/
# Top-level preset/demo renders (were tracked as 37 MB bloat, D5): keep on
# disk but never in git — same artifact class as /renderinggen/* variants.
# .gitignore only covered /renderinggen/*.mp4 + 5 subdirs, not these roots.
/preset_videos/
/phrase_preset_videos/
# typewriter_phrase_videos was the last tracked top-level demo root (52 files,
# ~7 MB of mp4/timing/plan). Same class as the two above: on disk, never in git.
/typewriter_phrase_videos/
# apple_style_final_videos is the same artifact class again: rendered clips plus
# their sidecars, reproducible from the crime/discovery/young style presets.
/apple_style_final_videos/
assets/backgrounds/*.mp4

# Keep testdata/golden intentionally tiny: only canonical CI/regression fixtures.
/testdata/golden/*
!/testdata/golden/DejaVuSans.ttf
!/testdata/golden/Poppins-Bold.ttf
!/testdata/golden/apple.png
!/testdata/golden/background.jpg
!/testdata/golden/background.mp4
!/testdata/golden/golden-overlay-job-v1.json
!/testdata/golden/golden-overlay-job-v2.json
!/testdata/golden/golden-semantic-overlay-job-v1.json
!/testdata/golden/logo_pulse.png
!/testdata/golden/overlay_chart.png
!/testdata/golden/overlay_globe.png

# Debug scratch (plan dumps used while diagnosing the render graph) and
# Python bytecode are never committed.
/testdata/debug/
__pycache__/
*.pyc
