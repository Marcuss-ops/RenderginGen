{
  "schema": "chronon.render-plan.v2",
  "version": 2,
  "job_id": "typewriter_05_glitch",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps_num": 24,
    "fps_den": 1,
    "duration_frames": 120
  },
  "layers": [
    {
      "id": "background",
      "type": "color",
      "color": [
        0.02,
        0.027,
        0.051,
        1
      ],
      "size": [
        1920,
        1080
      ],
      "start_frame": 0,
      "duration_frames": 120
    },
    {
      "id": "item_1",
      "type": "text",
      "text": "MAXIMUM PERFORMANCE",
      "size": [
        1920,
        120
      ],
      "position": [
        0,
        0
      ],
      "style": {
        "font": "assets/fonts/Poppins-Bold.ttf",
        "font_size": 64,
        "fill": "#FFFFFF",
        "stroke": {
          "color": "#111827",
          "width": 3.5
        },
        "shadow": {
          "color": "#000000",
          "opacity": 0.72,
          "blur": 12,
          "offset": [
            0,
            4
          ]
        }
      },
      "start_frame": 0,
      "duration_frames": 120,
      "text_animators": [
        {
          "id": "typewriter_glitch_text",
          "selectors": [
            {
              "id": "typewriter_glitch_text_selector",
              "unit": "glyph",
              "shape": "square",
              "order": "forward",
              "combine": "replace",
              "start": {
                "property": "start",
                "keyframes": [
                  {
                    "frame": 0,
                    "value": 0
                  },
                  {
                    "frame": 72,
                    "value": 100
                  }
                ],
                "easing": "out_cubic"
              },
              "exclude_spaces": true
            }
          ],
          "properties": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0
                },
                {
                  "frame": 72,
                  "value": 0
                }
              ],
              "easing": "linear"
            },
            {
              "property": "position_x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 20
                },
                {
                  "frame": 72,
                  "value": 20
                }
              ],
              "easing": "out_cubic"
            },
            {
              "property": "scale_x",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.4
                },
                {
                  "frame": 72,
                  "value": 1.4
                }
              ],
              "easing": "out_cubic"
            }
          ]
        }
      ]
    }
  ],
  "output": {
    "path": "result.mp4",
    "format": "mp4",
    "codec": "h264"
  }
}
