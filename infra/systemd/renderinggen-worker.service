[Unit]
Description=RenderingGen native GPU worker
# Docker is deliberately NOT a dependency: the worker is host-native and
# must start (and restart) even while containers are down or being upgraded.
# Only PostgreSQL remains containerized, and only the queue talks to it.
After=network-online.target chronon3d.service renderinggen-queue.service
Wants=network-online.target
Requires=renderinggen-queue.service chronon3d.service

[Service]
Type=simple
User=pierone
# No WorkingDirectory: the worker resolves every asset/plan path from its own
# config, so the unit carries no machine-specific source checkout path.
ExecStart=/usr/local/bin/renderinggen --config /etc/renderinggen/renderinggen.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
