[Unit]
Description=RenderingGen native GPU worker
# Docker is deliberately NOT a dependency: the worker is host-native and
# must start (and restart) even while containers are down or being upgraded.
# Only PostgreSQL remains containerized, and only the queue talks to it.
After=network-online.target chronon3d.service renderinggen-queue.service
Wants=network-online.target
Requires=renderinggen-queue.service chronon3d.service

[Service]
Type=simple
User=pierone
# No WorkingDirectory: the worker resolves every asset/plan path from its own
# config, so the unit carries no machine-specific source checkout path.
ExecStart=/usr/local/bin/renderinggen --config /etc/renderinggen/renderinggen.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
# Go runtime memory policy (pinned by
# renderinggen/internal/architecture/conformance_runtime_env_test.go).
# GOMEMLIMIT is a SOFT cap: below it the GC keeps its normal pacing, near it
# the runtime ramps the GC instead of growing the heap — so a pathological job
# degrades into GC pressure instead of an OOM kill on the GPU host. 4GiB
# covers the default 512MiB L1 RAM cache (artifact_store.l1_max_bytes) plus
# per-job plan/staging bytes, the probe cache and upload buffers. Operators
# who raise l1_max_bytes (or run with 0 = unbounded) must raise this too.
# GOGC=100 is Go's default, kept explicit next to the cap on purpose: with
# GOMEMLIMIT set the soft cap alone bounds the heap, so the GC percentage
# stays at its throughput-friendly default and tuning one knob never hides
# the other.
Environment=GOGC=100 GOMEMLIMIT=4GiB

[Install]
WantedBy=multi-user.target
