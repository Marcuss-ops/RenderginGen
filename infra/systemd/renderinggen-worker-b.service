[Unit]
Description=RenderingGen native GPU worker B
# Docker is deliberately NOT a dependency: the worker is host-native and
# must start (and restart) even while containers are down or being upgraded.
# Only PostgreSQL remains containerized, and only the queue talks to it.
#
# Ordering mirrors the primary worker: the worker needs the QUEUE, not the
# daemon (the daemon is reached lazily over IPC and restarts independently).
# Worker B additionally needs its OWN daemon instance, chronon3d-b.service,
# which serves the dedicated socket in renderinggen-b.yaml. Without that unit
# the worker starts but every render fails to connect.
After=network-online.target renderinggen-queue.service chronon3d-b.service
Wants=network-online.target
Requires=renderinggen-queue.service

[Service]
Type=simple
User=pierone
# No machine-specific source checkout path: the worker resolves every
# asset/plan path from its own config and renders from the plan's directory.
# It still needs a WRITABLE cwd for `chronon3d_cli doctor`
# (filesystem.output_writable is probed relative to cwd); RuntimeDirectory
# provides one that exists at boot and is owned by the service user.
RuntimeDirectory=renderinggen-b
RuntimeDirectoryMode=0750
WorkingDirectory=/run/renderinggen-b
ExecStart=/usr/local/bin/renderinggen --config /etc/renderinggen/renderinggen-b.yaml
Restart=on-failure
RestartSec=2
LimitNOFILE=65536
# Go runtime memory policy — same contract as renderinggen-worker.service
# (pinned by renderinggen/internal/architecture/conformance_runtime_env_test.go):
# GOMEMLIMIT is the soft cap that turns a pathological job into GC pressure
# instead of an OOM kill; GOGC=100 stays at Go's default next to it. Raise
# GOMEMLIMIT together with artifact_store.l1_max_bytes in renderinggen-b.yaml.
Environment=GOGC=100 GOMEMLIMIT=4GiB
# Same explicit Natural Earth catalog as worker A: the loader never searches
# the source tree, so the deployment-owned copy must be named here.
Environment=CHRONONTEMPLATE_CATALOG=/var/lib/renderinggen/catalog

[Install]
WantedBy=multi-user.target
