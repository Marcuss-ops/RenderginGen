[Unit]
Description=RenderingGen central job queue
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=pierone
# The wrapper maps the canonical operator-owned PipelineGen media DSN to the
# queue's DATABASE_URL without duplicating the secret in /etc or the repo.
#
# RENDERINGGEN_ENV_FILE is the ONE place the .env location is declared: the file
# lives in the operator's PipelineGen checkout, whose path is host-specific, so
# it is deployment configuration. The wrapper refuses to start without a
# readable file, which turns a wrong path into a loud failure at boot instead of
# a queue that starts with an empty DSN.
Environment=RENDERINGGEN_ENV_FILE=/etc/renderinggen/queue.env
# Shutdown window. The queue drains in-flight requests on SIGTERM (see
# cmd/queued/main.go); systemd's default 90 s stop timeout would SIGKILL first
# only if the drain hung, but the explicit pair below keeps the two numbers in
# one place: --shutdown-timeout is how long the process may drain, and
# TimeoutStopSec is the hard ceiling systemd waits before it kills.
ExecStart=/usr/local/libexec/renderinggen-queue-wrapper --backend=postgres --addr 127.0.0.1:8081 --lease 10m --worker-stale-after 3m --shutdown-timeout=25s
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
