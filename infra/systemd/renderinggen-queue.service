[Unit]
Description=RenderingGen central job queue
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=pierone
# The wrapper maps the canonical operator-owned PipelineGen media DSN to the
# queue's DATABASE_URL without duplicating the secret in /etc or the repo.
ExecStart=/usr/local/libexec/renderinggen-queue-wrapper --addr 127.0.0.1:8081 --lease 10m --worker-stale-after 3m
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
