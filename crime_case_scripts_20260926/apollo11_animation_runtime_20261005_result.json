l modulo lunare Eagle ripartì il 21 luglio e l'equipaggio tornò sulla Terra il 24 luglio. La missione si concluse con l'ammaraggio nell'Oceano Pacifico. Le date della partenza, dell'allunaggio e del ritorno scandiscono un viaggio durato otto giorni.","cache":{},"research":{}},"script_params":{"target_words":120,"min_words":80,"segment_words":60,"segments":[{"id":"apollo11-launch-florida","kind":"narration","topic":"Il lancio di Apollo 11 dal Kennedy Space Center il 16 luglio 1969","source_text":"Il 16 luglio 1969, il Saturn V decolla dal Kennedy Space Center, in Florida. A bordo di Apollo 11 ci sono Neil Armstrong, Buzz Aldrin e Michael Collins. La NASA avvia così il viaggio che porterà due astronauti sulla Luna.","target_words":60,"min_words":40},{"id":"apollo11-moon-landing","kind":"narration","topic":"Neil Armstrong e Buzz Aldrin raggiungono la Luna il 20 luglio 1969","source_text":"Il 20 luglio, il modulo Eagle raggiunge la superficie lunare. Neil Armstrong scende per primo, Buzz Aldrin lo segue, mentre Michael Collins resta in orbita. Dopo la ripartenza del modulo il 21 luglio, l'equipaggio rientra sulla Terra il 24 luglio.","target_words":60,"min_words":40}]},"output":{"render":{"enabled":true,"subtitles":{},"require_gpu":true},"audio":{},"extract_entities":"enabled","generate_metadata":"enabled","save_to_db":true,"generate_timeline":true,"voiceover_enabled":"disabled"},"overlay_background":{"kind":"color","color":[0.025,0.035,0.06,1],"fit":"cover","opacity":1},"max_phrase_overlays":4,"max_image_overlays":4,"audio":{},"docs":{"enabled":false},"media_plan":{"mode":"hybrid","provider_policy":{"artlist":"disabled","youtube":"disabled","internet_images":"enabled","image_generation":"disabled","geocoding":"enabled"},"cache":{"read":true,"write":true},"extraction":{"enabled":true,"include":["entities","special_names","important_phrases","metrics","dates","locations"],"max_entities_per_segment":5,"max_important_phrases_per_segment":2,"important_phrases":["Il primo al