{
  "schema": "chronon.render-plan.v2",
  "version": 2,
  "job_id": "typography-12_opacity_wave",
  "canvas": {
    "width": 1920,
    "height": 1080,
    "fps_num": 24,
    "fps_den": 1,
    "duration_frames": 120
  },
  "layers": [
    {
      "id": "title",
      "type": "text",
      "text": "Designed for speed.",
      "size": [
        1920,
        120
      ],
      "position": [
        0,
        64.8
      ],
      "style": {
        "font": "assets/fonts/Poppins-Bold.ttf",
        "font_size": 58,
        "fill": "#FFFFFF"
      },
      "start_frame": 0,
      "duration_frames": 120,
      "text_animators": [
        {
          "id": "opacity_wave_text",
          "selectors": [
            {
              "id": "opacity_wave_text_selector",
              "unit": "word",
              "shape": "smooth",
              "order": "forward",
              "combine": "replace",
              "end": {
                "property": "end",
                "keyframes": [
                  {
                    "frame": 0,
                    "value": 0
                  },
                  {
                    "frame": 120,
                    "value": 100
                  }
                ],
                "easing": "out_cubic"
              },
              "exclude_spaces": true
            }
          ],
          "properties": [
            {
              "property": "opacity",
              "keyframes": [
                {
                  "frame": 0,
                  "value": 0.25
                },
                {
                  "frame": 7,
                  "value": 1
                },
                {
                  "frame": 17,
                  "value": 0.55
                }
              ],
              "easing": "in_out_sine"
            }
          ]
        }
      ]
    }
  ],
  "output": {
    "path": "result.mp4",
    "format": "mp4",
    "codec": "h264",
    "profile_id": "preview"
  }
}
