{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderinggen.dev/schemas/overlay-plan.v1.schema.json",
  "title": "RenderingGen Overlay Plan V1",
  "description": "Semantic overlay instructions emitted by PipelineGen and compiled by RenderingGen into a Chronon render plan.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "video_id", "width", "height", "fps_num", "fps_den"],
  "properties": {
    "schema_version": { "const": "renderinggen.overlay-plan.v1" },
    "plan_id": { "type": "string", "minLength": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps_num": { "type": "integer", "minimum": 1, "description": "FPS numerator (rational framerate). Use with fps_den." },
    "fps_den": { "type": "integer", "minimum": 1, "description": "FPS denominator (rational framerate). Use with fps_num." },
    "duration_ms": { "type": "integer", "minimum": 0, "description": "Explicit clip duration in milliseconds. Required when items is empty (clip render without entity overlays). Items can extend but not shorten the canvas duration." },
    "output_profile_id": { "type": "string", "minLength": 1 },
    "style_profile": { "enum": ["discovery", "young", "crime"] },
    "renderer_version": { "type": "string" },
    "fingerprint": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "sha256"],
      "properties": {
        "asset_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "sha256": { "type": "string", "minLength": 1 }
      }
    },
    "foreground_scale_percent": { "type": "integer", "minimum": 1, "maximum": 100 },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["none", "color", "image", "video"] },
        "asset_refs": { "type": "array", "items": { "$ref": "#/properties/items/items/properties/asset_refs/items" } },
        "color": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
        "fit": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop": { "type": "boolean" }
      }
    },
    "subtitles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "asset_refs": { "type": "array", "items": { "$ref": "#/properties/items/items/properties/asset_refs/items" } },
        "style_id": { "type": "string" },
        "mode": { "enum": ["burn", "sidecar"] },
        "style": { "type": "object" }
      }
    },
    "watermark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "asset_refs": { "type": "array", "items": { "$ref": "#/properties/items/items/properties/asset_refs/items" } },
        "position": { "type": "string" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "margin_px": { "type": "integer", "minimum": 0, "description": "Requested distance from the canvas edge. Required for text watermarks: the worker never guesses layout." },
        "font_ref": { "$ref": "#/properties/items/items/properties/asset_refs/items", "description": "Font asset of a text watermark. Required when text is set: the worker never invents typography." },
        "style": { "type": "object" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["copy_if_compatible", "transcode"] },
        "codec": { "type": "string" },
        "sample_rate": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "start_ms", "end_ms", "template_id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "scene_id": { "type": "string" },
          "entity_id": { "type": "string" },
          "kind": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "exclusiveMinimum": 0 },
          "template_id": { "type": "string", "minLength": 1 },
          "preset_id": { "type": "string", "minLength": 1, "description": "Semantic visual preset resolved by PipelineGen's SemanticOverlayResolver (ADR-029). REQUIRED for preset-driven templates (text cards, IMAGE_OVERLAY); ABSENT for preset-less primitives (PRODUCT, LOGO, LIGHT_LEAK, BACKGROUND, SHAPE) which compile to a bare renderer-default layer." },
          "image_preset_id": { "type": "string", "minLength": 1, "description": "Image-layer preset for an entity card that carries an asset (the text preset stays in preset_id). Validated against the same official catalog." },
          "motion_id": { "type": "string", "minLength": 1, "description": "Per-item motion override resolved through the RenderingGen motion registry. When present it replaces the preset's motion." },
          "motion_params": { "type": "object", "description": "Motion parameters passed to the motion plugin for this item." },
          "text": { "type": "string" },
          "params": { "type": "object" },
          "render_key": { "type": "string" },
          "asset_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "sha256"],
              "properties": {
                "asset_id": { "type": "string", "minLength": 1 },
                "url": { "type": "string" },
                "sha256": { "type": "string", "minLength": 1 },
                "media_type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
