{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://renderinggen.dev/schemas/motion-deprecation-audit-report.v1.schema.json",
  "title": "RenderingGen Motion Deprecation Audit Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "motion_id", "replacement_id", "owner",
    "deprecated_on", "remove_after", "audit_date", "registry_present",
    "selectable_before_deprecation", "replacement_present", "targets_compatible",
    "consumers", "declared_consumers", "undeclared_consumers",
    "missing_declared_consumers", "compatibility_window_days", "gate", "limitations"
  ],
  "properties": {
    "schema": { "const": "renderinggen.motion-deprecation-audit.v1" },
    "version": { "const": 1 },
    "motion_id": { "type": "string", "minLength": 1 },
    "replacement_id": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "deprecated_on": { "type": "string", "format": "date" },
    "remove_after": { "type": "string", "format": "date" },
    "audit_date": { "type": "string", "format": "date" },
    "registry_present": { "type": "boolean" },
    "selectable_before_deprecation": { "type": "boolean" },
    "replacement_present": { "type": "boolean" },
    "targets_compatible": { "type": "boolean" },
    "consumers": { "$ref": "#/$defs/paths" },
    "declared_consumers": { "$ref": "#/$defs/paths" },
    "undeclared_consumers": { "$ref": "#/$defs/paths" },
    "missing_declared_consumers": { "$ref": "#/$defs/paths" },
    "compatibility_window_days": { "type": "integer", "minimum": 30 },
    "gate": { "enum": ["PASS_AUDIT_ONLY", "BLOCKED"] },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
